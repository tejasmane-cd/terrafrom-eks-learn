environment    = "dev"
aws_region     = "us-east-1"
cluster_name   = "eks-learn-dev"
vpc_cidr       = "10.10.0.0/16"
kubernetes_version = "1.36"

# Required: restrict to your office/VPN IP — never leave as 0.0.0.0/0 in shared accounts
# Dev: ["0.0.0.0/0"] is fine for learning; prod should use your IP only
endpoint_public_access_cidrs = ["0.0.0.0/0"]

# EKS console read access (Nodes tab): add your console IAM user/role ARN
# eks_console_viewer_principal_arns = ["arn:aws:iam::ACCOUNT_ID:user/your-user"]

cert_manager_acme_email = "you@example.com"

# Optional: automated Route53 DNS for Ingress/Service hostnames
# enable_external_dns = true
# external_dns_route53_hosted_zone_arns = ["arn:aws:route53:::hostedzone/Z1234567890ABC"]
# external_dns_domain_filters           = ["example.com"]

tags = {
  Owner = "your-name"
}
